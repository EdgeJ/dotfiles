#!/bin/bash

# Git Worktree Cleanup Script
# Removes worktrees that are not tracking branches on remote origin

set -e  # Exit on any error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
print_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    print_error "Not in a git repository!"
    exit 1
fi

# Check if origin remote exists
if ! git remote | grep -q "^origin$"; then
    print_error "No 'origin' remote found!"
    exit 1
fi

print_info "Fetching latest remote information..."
git fetch origin --prune

print_info "Getting list of remote branches..."
# Get all remote branches (excluding HEAD)
remote_branches=$(git ls-remote --heads origin | awk '{print $2}' | sed 's|refs/heads/||')

print_info "Getting list of worktrees..."
# Use porcelain format for reliable parsing
worktrees_to_remove=()

# Parse git worktree list --porcelain output
current_worktree=""
current_branch=""

while IFS= read -r line; do
    # Skip empty lines
    [[ -z "$line" ]] && continue
    
    if [[ "$line" == worktree* ]]; then
        # Process previous worktree if we have both path and branch
        if [[ -n "$current_worktree" ]] && [[ -n "$current_branch" ]]; then
            print_info "Checking worktree: $current_worktree (branch: $current_branch)"
            
            # Check if branch exists on remote origin
            if echo "$remote_branches" | grep -q "^${current_branch}$"; then
                print_success "Branch '$current_branch' exists on origin - keeping worktree"
            else
                print_warning "Branch '$current_branch' not found on origin - marking for removal"
                worktrees_to_remove+=("$current_worktree:$current_branch")
            fi
        fi
        
        # Extract new worktree path
        current_worktree="${line#worktree }"
        current_branch=""
        
    elif [[ "$line" == "branch refs/heads/"* ]]; then
        # Extract branch name
        current_branch="${line#branch refs/heads/}"
        
    elif [[ "$line" == "detached" ]]; then
        # This is a detached HEAD - skip it
        if [[ -n "$current_worktree" ]]; then
            print_warning "Skipping detached HEAD worktree: $current_worktree"
            current_worktree=""
            current_branch=""
        fi
    elif [[ "$line" == "bare" ]]; then
        # This is the bare repository - skip it
        if [[ -n "$current_worktree" ]]; then
            print_info "Skipping bare repository: $current_worktree"
            current_worktree=""
            current_branch=""
        fi
    fi
done < <(git worktree list --porcelain)

# Don't forget to process the last worktree
if [[ -n "$current_worktree" ]] && [[ -n "$current_branch" ]]; then
    print_info "Checking worktree: $current_worktree (branch: $current_branch)"
    
    # Check if branch exists on remote origin
    if echo "$remote_branches" | grep -q "^${current_branch}$"; then
        print_success "Branch '$current_branch' exists on origin - keeping worktree"
    else
        print_warning "Branch '$current_branch' not found on origin - marking for removal"
        worktrees_to_remove+=("$current_worktree:$current_branch")
    fi
fi

# Check if there are worktrees to remove
if [[ ${#worktrees_to_remove[@]} -eq 0 ]]; then
    print_success "No worktrees need to be removed!"
    exit 0
fi

echo
print_info "Found ${#worktrees_to_remove[@]} worktree(s) to remove:"
for item in "${worktrees_to_remove[@]}"; do
    path="${item%:*}"
    branch="${item#*:}"
    echo "  - $path (branch: $branch)"
done

echo
# Ask for confirmation
read -p "Do you want to remove these worktrees? [y/N]: " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    print_info "Operation cancelled."
    exit 0
fi

# Remove the worktrees
echo
print_info "Removing worktrees..."
for item in "${worktrees_to_remove[@]}"; do
    path="${item%:*}"
    branch="${item#*:}"
    
    print_info "Removing worktree: $path"
    if git worktree remove "$path" --force; then
        print_success "Successfully removed worktree: $path"
    else
        print_error "Failed to remove worktree: $path"
    fi
done

print_success "Worktree cleanup completed!"

# Optional: Show remaining worktrees
echo
print_info "Remaining worktrees:"
git worktree list